<local:Window
    x:Class="StarRail.Source.UI.Window.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:UIDesign.Source.UI.Panel;assembly=UIDesign"
    xmlns:dsuc="clr-namespace:UIDesign.Source.UI.Control;assembly=UIDesign"
    Title="Star Rail Damage" Height="720" Width="1080"
    WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">
    <Window.DataContext>
        <Binding RelativeSource="{RelativeSource Self}"/>
    </Window.DataContext>
    
    <local:Window.Background>
        <ImageBrush ImageSource="/Source/Resource/Wallpaper/Backgroup.png"/>
    </local:Window.Background>
    
    <Grid>
        <dsuc:TabControl ItemsSource="{Binding TabItems}" SelectedIndex="{Binding SelectedIndex,Mode=TwoWay}" TabItemClose="TabItemClose"/>
    </Grid>
</local:Window>