<UserControl
    x:Class="StarRail.Source.UI.View.TabulateSpan"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:StarRail.Source.UI.View"
    xmlns:dsup="clr-namespace:UIDesign.Source.UI.Panel;assembly=UIDesign">
    <UserControl.Template>
        <ControlTemplate TargetType="{x:Type UserControl}">
            <Grid>
                <dsup:ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden">
                    <local:TabulateItem Model="{Binding Select,RelativeSource={RelativeSource AncestorType={x:Type local:TabulateSpan}}}" MouseLeftButtonUp="ItemDropdown"/>
                </dsup:ScrollViewer>

                <Popup IsOpen="{Binding Dropdown,RelativeSource={RelativeSource AncestorType={x:Type local:TabulateSpan}},Mode=TwoWay}" AllowsTransparency="True" StaysOpen="False" Placement="Center" PopupAnimation="Fade">
                    <Border CornerRadius="20" Background="{Binding Background,RelativeSource={RelativeSource AncestorType={x:Type local:TabulateSpan}}}">
                        <dsup:ScrollViewer Margin="5" Width="{TemplateBinding Width}" Height="{Binding DropdownHeight,RelativeSource={RelativeSource AncestorType={x:Type local:TabulateSpan}}}" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden">
                            <ItemsControl Margin="10" ItemsSource="{Binding Items,RelativeSource={RelativeSource AncestorType={x:Type local:TabulateSpan}}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <dsup:StackPanel Orientation="Vertical" Spacing="5"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <local:TabulateItem Model="{Binding}" MouseLeftButtonUp="ItemSelected" CheckCharged="CheckBoxClick" ModifyClick="ModifyItemClick" DeleteClick="DeleteItemClick"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </dsup:ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
        </ControlTemplate>
    </UserControl.Template>
</UserControl>