<UserControl
    x:Class="StarRail.Source.UI.View.TabulateItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:StarRail.Source.UI.View"
    xmlns:dsup="clr-namespace:UIDesign.Source.UI.Panel;assembly=UIDesign"
    xmlns:dsuc="clr-namespace:UIDesign.Source.UI.Control;assembly=UIDesign">
    <UserControl.Template>
        <ControlTemplate TargetType="{x:Type UserControl}">
            <Border CornerRadius="10" Background="{TemplateBinding Background}">
                <Grid Margin="15,10,15,10" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="25"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Image Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Width="50" Height="50" Margin="0,0,5,0" Source="{Binding Model.Icon,RelativeSource={RelativeSource AncestorType={x:Type local:TabulateItem}}}"/>

                    <dsuc:TextBlock Grid.Column="1" Grid.Row="0" Margin="5,0,5,0" Text="{Binding Model.Title,RelativeSource={RelativeSource AncestorType={x:Type local:TabulateItem}}}" TipText="{Binding Text,RelativeSource={RelativeSource Self}}" TipOnlyTrim="True" TextTrimming="CharacterEllipsis" FontWeight="Bold" VerticalAlignment="Center">
                        <dsuc:TextBlock.Style>
                            <Style TargetType="{x:Type dsuc:TextBlock}">
                                <Setter Property="Foreground" Value="{Binding TitleBrush,RelativeSource={RelativeSource AncestorType={x:Type local:TabulateItem}}}"/>
                                <Setter Property="FontSize" Value="{Binding TitleFontSize,RelativeSource={RelativeSource AncestorType={x:Type local:TabulateItem}}}"/>
                            </Style>
                        </dsuc:TextBlock.Style>
                    </dsuc:TextBlock>

                    <StackPanel Grid.Column="2" Grid.Row="0" Orientation="Horizontal">
                        <StackPanel.Resources>
                            <Style TargetType="{x:Type dsuc:Button}">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="FocusBrush" Value="{Binding FocusBrush,RelativeSource={RelativeSource AncestorType={x:Type local:TabulateItem}}}"/>
                                <Setter Property="Width" Value="20"/>
                                <Setter Property="Height" Value="20"/>
                            </Style>
                        </StackPanel.Resources>

                        <dsuc:Button Click="ModifyItemClick">
                            <Image Source="/UIDesign;component/Source/Resource/Icon/Modify.png"/>
                        </dsuc:Button>
                        <dsuc:Button Click="DeleteItemClick">
                            <Image Source="/UIDesign;component/Source/Resource/Icon/Delete.png"/>
                        </dsuc:Button>
                        <dsuc:CheckBox Flag="{Binding Model.Flag,RelativeSource={RelativeSource AncestorType={x:Type local:TabulateItem}},Mode=TwoWay}"/>
                    </StackPanel>

                    <dsup:ScrollViewer Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2" Margin="5,0,0,0" VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <dsup:StackPanel Orientation="Horizontal" Spacing="5">
                            <local:MarkupSpan Items="{Binding Model.MarkItems,RelativeSource={RelativeSource AncestorType={x:Type local:TabulateItem}}}" Spacing="5"/>
                        </dsup:StackPanel>
                    </dsup:ScrollViewer>

                    <dsuc:Expander Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="3">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0" Margin="5" Text="{Binding Model.Text,RelativeSource={RelativeSource AncestorType={x:Type local:TabulateItem}}}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="Foreground" Value="{Binding Foreground,RelativeSource={RelativeSource AncestorType={x:Type local:TabulateItem}}}"/>
                                        <Setter Property="FontSize" Value="{Binding FontSize,RelativeSource={RelativeSource AncestorType={x:Type local:TabulateItem}}}"/>
                                        <Setter Property="FontWeight" Value="{Binding FontWeight,RelativeSource={RelativeSource AncestorType={x:Type local:TabulateItem}}}"/>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <ContentControl Grid.Row="1" Margin="5,0,5,0"/>
                        </Grid>
                    </dsuc:Expander>
                </Grid>
            </Border>
        </ControlTemplate>
    </UserControl.Template>
</UserControl>