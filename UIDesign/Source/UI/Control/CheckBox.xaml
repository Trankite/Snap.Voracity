<UserControl
    x:Class="UIDesign.Source.UI.Control.CheckBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:UIDesign.Source.UI.Control">
    <UserControl.Template>
        <ControlTemplate TargetType="{x:Type UserControl}">
            <Grid Height="{TemplateBinding Height}">
                <Grid.Resources>
                    <Style TargetType="{x:Type local:TextBlock}">
                        <Setter Property="Foreground" Value="{Binding Foreground,RelativeSource={RelativeSource AncestorType={x:Type local:CheckBox}}}"/>
                        <Setter Property="FontSize" Value="{Binding FontSize,RelativeSource={RelativeSource AncestorType={x:Type local:CheckBox}}}"/>
                        <Setter Property="FontWeight" Value="{Binding FontWeight,RelativeSource={RelativeSource AncestorType={x:Type local:CheckBox}}}"/>
                        <Setter Property="Margin" Value="{Binding Padding,RelativeSource={RelativeSource AncestorType={x:Type local:CheckBox}}}"/>
                    </Style>
                </Grid.Resources>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <local:Button Grid.Column="0" Width="{TemplateBinding Height}" Height="{TemplateBinding Height}" CornerRadius="5" Click="CheckBoxClick">
                    <Image>
                        <Image.Style>
                            <Style TargetType="{x:Type Image}">
                                <Setter Property="Source" Value="/UIDesign;component/Source/Resource/Icon/UnSelect.png"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Flag,RelativeSource={RelativeSource AncestorType={x:Type local:CheckBox}}}" Value="True">
                                        <Setter Property="Source" Value="/UIDesign;component/Source/Resource/Icon/Selected.png"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                </local:Button>

                <local:TextBlock Grid.Column="1" Text="{Binding Text,RelativeSource={RelativeSource AncestorType={x:Type local:CheckBox}}}" TipText="{Binding Text,RelativeSource={RelativeSource AncestorType={x:Type local:CheckBox}}}" TipOnlyTrim="True" TextTrimming="CharacterEllipsis" Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
                    <local:TextBlock.Style>
                        <Style TargetType="{x:Type local:TextBlock}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text,RelativeSource={RelativeSource AncestorType={x:Type local:CheckBox}}}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </local:TextBlock.Style>
                </local:TextBlock>
            </Grid>
        </ControlTemplate>
    </UserControl.Template>
</UserControl>