<TabControl
    x:Class="UIDesign.Source.UI.Control.TabControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:UIDesign.Source.UI.Control">
    <TabControl.Resources>
        <Style TargetType="{x:Type local:TabItem}">
            <Setter Property="Foreground" Value="{Binding Foreground,RelativeSource={RelativeSource AncestorType={x:Type local:TabControl}}}"/>
            <Setter Property="Background" Value="{Binding Background,RelativeSource={RelativeSource AncestorType={x:Type local:TabControl}}}"/>
            <Setter Property="FocusBrush" Value="{Binding FocusBrush,RelativeSource={RelativeSource AncestorType={x:Type local:TabControl}}}"/>
            <Setter Property="Padding" Value="{Binding Padding,RelativeSource={RelativeSource AncestorType={x:Type local:TabControl}}}"/>
        </Style>
    </TabControl.Resources>

    <TabControl.Template>
        <ControlTemplate TargetType="{x:Type TabControl}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="5"/>
                </Grid.RowDefinitions>

                <UniformGrid Grid.Row="0" Rows="1" IsItemsHost="True"/>
                <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
            </Grid>
        </ControlTemplate>
    </TabControl.Template>

    <TabControl.ItemTemplate>
        <DataTemplate>
            <local:TextBlock Text="{Binding Header}" TipText="{Binding Header}" TipOnlyTrim="True" TextTrimming="CharacterEllipsis" Foreground="{Binding Foreground,RelativeSource={RelativeSource AncestorType={x:Type local:TabControl}}}" FontSize="{Binding FontSize,RelativeSource={RelativeSource AncestorType={x:Type local:TabControl}}}" FontWeight="{Binding FontWeight,RelativeSource={RelativeSource AncestorType={x:Type local:TabControl}}}"/>
        </DataTemplate>
    </TabControl.ItemTemplate>

    <TabControl.ContentTemplate>
        <DataTemplate>
            <Frame Content="{Binding Content}" NavigationUIVisibility="Hidden"/>
        </DataTemplate>
    </TabControl.ContentTemplate>
</TabControl>